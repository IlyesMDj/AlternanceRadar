# Environnement
.venv/
__pycache__/
*.pyc

# Profil Chrome dédié au collecteur de posts — contient les cookies de session
# LinkedIn. À ne JAMAIS versionner.
.chrome-profile/

# Secrets
.env
*.key

# Config perso — coordonnées, CV/lettre, identifiants de candidature.
# Copie config.example.yaml en config.yaml et personnalise.
config.yaml

# Contenu réel du CV (expériences, formation...) et les PDF générés à partir.
# Copie cv_source.example.yaml en cv_source.yaml et personnalise.
cv_source.yaml
store/cv/

# État local des runs (cadence entre deux collectes, tour de rotation des
# mots-clés) : propre à cette machine, aucun intérêt à le partager.
.derniere_collecte_posts
.rotation_mots_cles_posts

# Données collectées
store/jobs.db
store/jobs.db-*
store/raw/
digest.html
